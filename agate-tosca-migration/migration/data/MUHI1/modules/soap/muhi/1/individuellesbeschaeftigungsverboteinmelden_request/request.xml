<s:Envelope xmlns:s="http://schemas.xmlsoap.org/soap/envelope/">
  <s:Header>
    <TransactionId>{B[TransactionId]}</TransactionId>
  </s:Header>
  <s:Body>
    <individuellesBeschaeftigungsverbotEinmelden xmlns="http://soap.muhi.client.chipkarte.at">
      <dialogId>{B[dialogId]}</dialogId>
      <req>
        <begruendung>{B[begruendung]}</begruendung>
        <begruendungVordatierung>{B[begruendungVordatierung]}</begruendungVordatierung>
        <commonData>
          <adressePatientin>
            <ort>{B[ort]}</ort>
            <postleitzahl>{B[postleitzahl]}</postleitzahl>
            <staatencode>{B[staatencode]}</staatencode>
            <strasse>{B[strasse]}</strasse>
          </adressePatientin>
          <cardToken>{B[cardToken]}</cardToken>
          <voraussichtlicherGeburtstermin>{B[voraussichtlicherGeburtstermin]}</voraussichtlicherGeburtstermin>
          <vsnr>{B[vsnr]}</vsnr>
        </commonData>
        <dauer>{B[dauer]}</dauer>
        <kzDauerBisAbsolut>{B[kzDauerBisAbsolut]}</kzDauerBisAbsolut>
        <kzVordatiert>{B[kzVordatiert]}</kzVordatiert>
        <zusatzbegruendung>{B[zusatzbegruendung]}</zusatzbegruendung>
      </req>
    </individuellesBeschaeftigungsverbotEinmelden>
  </s:Body>
</s:Envelope>
